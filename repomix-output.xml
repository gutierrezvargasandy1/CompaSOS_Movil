            "Contactos de emergencia"  -> navController.navigate(Screen.ContactosEmergencia.route)
            "Familia"                  -> navController.navigate(Screen.Familia.route)
            "Dispositivos"             -> navController.navigate(Screen.Dispositivos.route)
